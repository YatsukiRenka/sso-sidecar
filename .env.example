# Non-secret service configuration
ST_BACKEND=http://sillytavern:8000
LISTEN_PORT=8001
ADMIN_HANDLE=admin
ADMIN_GROUPS=admins,staff
AUTO_PROVISION=true
ALLOW_USERNAME_LINKING=false
TRUSTED_PROXY_CIDRS=172.30.0.10/32
ST_DATA_DIR=/st-data/data
STATE_FILE=/var/lib/sso-sidecar/mappings.json

# Prefer the corresponding *_FILE variables and Docker secrets in production.
ADMIN_PASSWORD=replace-with-at-least-20-characters
USER_PASSWORD_SECRET=replace-with-an-independent-32-character-secret

API_PROXY_ENABLED=true
API_BASE_URL=https://llm-api.example.net/v1
API_KEY=replace-with-the-real-upstream-key
API_PROXY_TOKEN=replace-with-a-random-service-token-at-least-32-characters
ALLOWED_MODELS=deepseek-v4-flash
DEFAULT_MODEL=deepseek-v4-flash
ST_API_BASE=http://sso-sidecar:8001/v1
API_MAX_BODY_BYTES=10485760
SSO_MAX_BODY_BYTES=524288000
UID_CACHE_TTL=300
SSO_BINDING_COOKIE_SECURE=true
